<UserControl x:Class="IISDeploy.Wpf.HostingSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Application pool and site settings, bound to the MainViewModel. Shown in the
         "Install new site" form and below the site list of "Update existing site". -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,14,0"
                        ToolTip="Application pool: AlwaysRunning starts the worker process with IIS, OnDemand with the first request.">
                <TextBlock Text="START MODE" Style="{StaticResource LabelText}" />
                <ComboBox Style="{StaticResource ModernComboBox}"
                          ItemsSource="{Binding StartModes}"
                          SelectedItem="{Binding AppPoolStartMode}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,14,0"
                        ToolTip="Application pool: minutes without a request before IIS shuts the worker process down. 0 never shuts it down.">
                <TextBlock Text="IDLE TIME-OUT (MINUTES)" Style="{StaticResource LabelText}" />
                <!-- Numeric spinner, as the port box of the install form. -->
                <Grid>
                    <TextBox Style="{StaticResource ModernTextBox}" Padding="12,0,34,0"
                             PreviewTextInput="NumberBox_PreviewTextInput"
                             DataObject.Pasting="NumberBox_Pasting"
                             Text="{Binding IdleTimeout, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                        <RepeatButton Style="{StaticResource SpinnerRepeatButton}" Content="&#xE70E;"
                                      Command="{Binding IdleTimeoutUpCommand}" ToolTip="Increase idle time-out" />
                        <RepeatButton Style="{StaticResource SpinnerRepeatButton}" Content="&#xE70D;"
                                      Margin="0,2,0,0" Command="{Binding IdleTimeoutDownCommand}" ToolTip="Decrease idle time-out" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        ToolTip="Site: warms the application up as soon as its worker process starts. Needs the IIS feature Application Initialization.">
                <TextBlock Text="PRELOAD ENABLED" Style="{StaticResource LabelText}" />
                <CheckBox Height="40" Style="{StaticResource ModernCheckBox}"
                          IsChecked="{Binding PreloadEnabled}"
                          Content="Warm up on start" />
            </StackPanel>
        </Grid>

        <!-- Blocking warning -->
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                    Visibility="{Binding IdleTimeoutInvalid, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="13"
                       Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Foreground="{StaticResource WarningBrush}" FontSize="12" VerticalAlignment="Center"
                       Text="Enter an idle time-out from 0 to 43200 minutes to continue." />
        </StackPanel>
    </StackPanel>
</UserControl>

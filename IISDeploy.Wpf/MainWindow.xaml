<Window x:Class="IISDeploy.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IISDeploy.Wpf"
        Title="IIS Deploy" Height="660" Width="920" MinHeight="560" MinWidth="720"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <local:PathToFileNameConverter x:Key="PathToFileName" />
        <local:SeverityToBrushConverter x:Key="SeverityToBrush" />
        <local:StepReachedToBrushConverter x:Key="StepReachedToBrush" />
        <local:ModeToBoolConverter x:Key="ModeToBool" />
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ======================= Title bar ======================= -->
            <Grid Grid.Row="0" Background="{StaticResource HeaderGradientBrush}">
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource AccentGradientBrush}">
                        <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="IIS Deploy" Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="Segoe UI Semibold" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <TextBlock Text="Publish a Publish.zip to IIS" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="12,1,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton" Click="MinimizeButton_Click" Width="46" Height="46"
                            Foreground="{StaticResource TextSecondaryBrush}" ToolTip="Minimize">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent">
                                    <TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="CloseButton" Click="CloseButton_Click" Width="46" Height="46"
                            Foreground="{StaticResource TextSecondaryBrush}" ToolTip="Close">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent">
                                    <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#E11D48" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ======================= Header / steps ======================= -->
            <Grid Grid.Row="1" Margin="28,22,28,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Step progress bar -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,18">
                    <local:StepPill Number="1" Caption="Package" StepNumber="{Binding StepNumber}" />
                    <Rectangle Width="34" Height="2" Margin="6,0" VerticalAlignment="Center"
                               Fill="{Binding StepNumber, Converter={StaticResource StepReachedToBrush}, ConverterParameter=2}" />
                    <local:StepPill Number="2" Caption="Configure" StepNumber="{Binding StepNumber}" />
                    <Rectangle Width="34" Height="2" Margin="6,0" VerticalAlignment="Center"
                               Fill="{Binding StepNumber, Converter={StaticResource StepReachedToBrush}, ConverterParameter=3}" />
                    <local:StepPill Number="3" Caption="Deploy" StepNumber="{Binding StepNumber}" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource TitleText}" />
                    <TextBlock Text="{Binding HeaderSubtitle}" Style="{StaticResource SubtitleText}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <!-- ======================= Content ======================= -->
            <Grid Grid.Row="2" Margin="28,8,28,8">

                <!-- Step 1: Package -->
                <Grid Visibility="{Binding IsPackageStep, Converter={StaticResource BoolToVis}}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPackageStep}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <StackPanel>
                        <TextBlock Text="FOLDER" Style="{StaticResource LabelText}" />
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource ModernTextBox}" IsReadOnly="True"
                                     Text="{Binding WorkingFolder, Mode=OneWay}" />
                            <Button Grid.Column="1" Content="Browse&#8230;" Style="{StaticResource SecondaryButton}"
                                    Margin="10,0,0,0" Command="{Binding BrowseCommand}" />
                        </Grid>

                        <TextBlock Text="DEPLOYMENT PACKAGE" Style="{StaticResource LabelText}" />
                        <TextBlock Text="{Binding ZipStatusMessage}" Style="{StaticResource SubtitleText}" Margin="0,0,0,10" />

                        <!-- Multiple ZIPs: selectable -->
                        <ComboBox Style="{StaticResource ModernComboBox}"
                                  Visibility="{Binding HasMultipleZips, Converter={StaticResource BoolToVis}}"
                                  ItemsSource="{Binding ZipFiles}"
                                  SelectedItem="{Binding SelectedZipPath}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding Converter={StaticResource PathToFileName}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Single ZIP: fixed, not changeable -->
                        <Border Visibility="{Binding HasSingleZip, Converter={StaticResource BoolToVis}}"
                                Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedZipName}" Foreground="{StaticResource TextPrimaryBrush}"
                                               FontFamily="Segoe UI Semibold" FontSize="14" />
                                    <TextBlock Text="This is the only package in the folder." Style="{StaticResource SubtitleText}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- No ZIP -->
                        <Border Visibility="{Binding HasZips, Converter={StaticResource InverseBoolToVis}}"
                                Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="No .zip file in this folder. Use Browse to locate your deployment package."
                                           Style="{StaticResource SubtitleText}" VerticalAlignment="Center" MaxWidth="600" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Step 2: Configure -->
                <Grid Visibility="{Binding IsConfigureStep, Converter={StaticResource BoolToVis}}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConfigureStep}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Mode selector: two general options -->
                        <UniformGrid Grid.Row="0" Rows="1" Columns="2" Margin="0,0,0,16">
                            <RadioButton Style="{StaticResource ModeCard}" GroupName="mode" Margin="0,0,6,0"
                                         IsChecked="{Binding Mode, Converter={StaticResource ModeToBool}, ConverterParameter=UpdateExisting}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="38" Height="38" CornerRadius="9" Background="{StaticResource SurfaceHoverBrush}" Margin="0,0,14,0">
                                        <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Update existing site" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontFamily="Segoe UI Semibold" FontSize="14" />
                                        <TextBlock Text="Deploy into a site already on this server" Style="{StaticResource SubtitleText}" />
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource ModeCard}" GroupName="mode" Margin="6,0,0,0"
                                         Checked="InstallModeCard_Checked"
                                         IsChecked="{Binding Mode, Converter={StaticResource ModeToBool}, ConverterParameter=InstallNew}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="38" Height="38" CornerRadius="9" Background="{StaticResource SurfaceHoverBrush}" Margin="0,0,14,0">
                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Install new site" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontFamily="Segoe UI Semibold" FontSize="14" />
                                        <TextBlock Text="Create a new IIS site with HTTPS + certificate" Style="{StaticResource SubtitleText}" />
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>

                        <!-- Update existing: list of installed sites -->
                        <Grid Grid.Row="1" Visibility="{Binding IsUpdateMode, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                                        Visibility="{Binding IsLoadingSites, Converter={StaticResource BoolToVis}}">
                                <local:Spinner Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="Reading installed IIS sites&#8230;" Style="{StaticResource SubtitleText}"
                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>

                            <Grid Visibility="{Binding IsLoadingSites, Converter={StaticResource InverseBoolToVis}}">
                                <!-- Sites error -->
                                <Border VerticalAlignment="Top"
                                        Visibility="{Binding HasSitesError, Converter={StaticResource BoolToVis}}"
                                        Background="#2A1620" BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="14,10">
                                    <TextBlock Text="{Binding SitesError}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" />
                                </Border>

                                <Grid Visibility="{Binding HasSitesError, Converter={StaticResource InverseBoolToVis}}">
                                    <!-- Empty: no sites installed -->
                                    <Border VerticalAlignment="Top"
                                            Visibility="{Binding HasSites, Converter={StaticResource InverseBoolToVis}}"
                                            Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="14,12">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                                       Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <TextBlock Text="No IIS sites are installed on this server. Choose &quot;Install new site&quot; instead."
                                                       Style="{StaticResource SubtitleText}" VerticalAlignment="Center" MaxWidth="600" />
                                        </StackPanel>
                                    </Border>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  Visibility="{Binding HasSites, Converter={StaticResource BoolToVis}}">
                                        <ListBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}"
                                                 Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Margin" Value="0,0,0,8" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="bd" CornerRadius="10" Padding="16,13"
                                                                        Background="{StaticResource SurfaceBrush}"
                                                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9"
                                                                                Background="{StaticResource SurfaceHoverBrush}" Margin="0,0,14,0">
                                                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                                                                       FontSize="16" Foreground="{StaticResource AccentBrush}"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}"
                                                                                       FontFamily="Segoe UI Semibold" FontSize="14" />
                                                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubtitleText}"
                                                                                       TextTrimming="CharacterEllipsis" MaxWidth="620" HorizontalAlignment="Left" />
                                                                        </StackPanel>
                                                                        <TextBlock x:Name="check" Grid.Column="2" Text="&#xE73E;"
                                                                                   FontFamily="{StaticResource IconFont}" FontSize="16"
                                                                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                                                                   Opacity="0" />
                                                                    </Grid>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                                        <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                                                                        <Setter TargetName="check" Property="Opacity" Value="1" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- Install new: name + port form -->
                        <Border Grid.Row="1" VerticalAlignment="Top" CornerRadius="10" Padding="16"
                                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Visibility="{Binding IsInstallMode, Converter={StaticResource BoolToVis}}">
                            <Border.RenderTransform>
                                <TranslateTransform Y="0" />
                            </Border.RenderTransform>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInstallMode}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.28" />
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                         From="-12" To="0" Duration="0:0:0.32">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                        <TextBlock Text="NEW SITE NAME" Style="{StaticResource LabelText}" />
                                        <TextBox x:Name="NewSiteNameBox" Style="{StaticResource ModernTextBox}"
                                                 Text="{Binding NewSiteName, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="PORT" Style="{StaticResource LabelText}" />
                                        <TextBox Style="{StaticResource ModernTextBox}"
                                                 Text="{Binding NewSitePort, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Configure this site now (always available for a new install) -->
                                <StackPanel>
                                    <CheckBox Margin="0,16,0,0" Style="{StaticResource ModernCheckBox}"
                                              IsChecked="{Binding ConfigureSite}"
                                              Content="Configure this site and start it after install" />

                                    <StackPanel Margin="30,10,0,0"
                                                Visibility="{Binding ConfigureSite, Converter={StaticResource BoolToVis}}">

                                        <!-- Config file editors (only for templates in the package) -->
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding CanConfigureFiles, Converter={StaticResource BoolToVis}}">
                                            <Button Content="Edit appsettings.json" Style="{StaticResource LinkButton}"
                                                    Command="{Binding EditAppSettingsCommand}"
                                                    Visibility="{Binding HasAppSettingsTemplate, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="|" Foreground="{StaticResource BorderBrush}"
                                                       VerticalAlignment="Center" Margin="14,0,14,0"
                                                       Visibility="{Binding HasBothTemplates, Converter={StaticResource BoolToVis}}" />
                                            <Button Content="Edit web.config" Style="{StaticResource LinkButton}"
                                                    Command="{Binding EditWebConfigCommand}"
                                                    Visibility="{Binding HasWebConfigTemplate, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>

                                        <!-- Application pool identity -->
                                        <CheckBox Margin="0,14,0,0" Style="{StaticResource ModernCheckBox}"
                                                  IsChecked="{Binding UseCustomIdentity}"
                                                  Content="Run the application pool under a specific account" />
                                        <Grid Margin="30,10,0,0"
                                              Visibility="{Binding UseCustomIdentity, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="USER NAME" Style="{StaticResource LabelText}" />
                                                <TextBox Style="{StaticResource ModernTextBox}"
                                                         Text="{Binding AppPoolUserName, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="PASSWORD" Style="{StaticResource LabelText}" />
                                                <PasswordBox x:Name="AppPoolPasswordBox" Style="{StaticResource ModernPasswordBox}"
                                                             PasswordChanged="AppPoolPasswordBox_PasswordChanged" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Blocking warning -->
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                                    Visibility="{Binding ConfigurationIncomplete, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                       Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Foreground="{StaticResource WarningBrush}" FontSize="12" VerticalAlignment="Center"
                                                       Text="Complete the configuration file(s) and account details to continue." />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Step 3: Deploy -->
                <Grid Visibility="{Binding IsDeployStep, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Status strip -->
                    <Border Grid.Row="0" CornerRadius="10" Padding="14,12" Margin="0,0,0,10"
                            Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                <local:Spinner Width="20" Height="20" VerticalAlignment="Center" />
                                <TextBlock Text="Working&#8230; please do not close the window." Style="{StaticResource SubtitleText}"
                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsFinished, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                           Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"
                                           Visibility="{Binding HadError, Converter={StaticResource InverseBoolToVis}}" />
                                <TextBlock Text="&#xEA39;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                           Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center"
                                           Visibility="{Binding HadError, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding ResultSummary}" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontFamily="Segoe UI Semibold" FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Log output -->
                    <Border Grid.Row="1" CornerRadius="10" Background="#0A0E16"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <ScrollViewer x:Name="LogScrollViewer" Padding="16,12" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding LogEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Opacity="0" Margin="0,1" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <TranslateTransform X="18" />
                                            </Border.RenderTransform>
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.28" />
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                             From="18" To="0" Duration="0:0:0.34">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Border.Triggers>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding TimestampText}" FontFamily="Consolas"
                                                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                                                           Opacity="0.7" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="Consolas"
                                                           FontSize="12.5" TextWrapping="Wrap"
                                                           Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- ======================= Footer ======================= -->
            <Border Grid.Row="3" Background="{StaticResource HeaderGradientBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="28,14">
                <Grid>
                    <Button Content="Back" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                            Command="{Binding BackCommand}"
                            Visibility="{Binding IsConfigureStep, Converter={StaticResource BoolToVis}}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Package / Configure: Next -->
                        <Button Content="{Binding NextButtonText}" Style="{StaticResource PrimaryButton}" MinWidth="130"
                                Command="{Binding NextCommand}"
                                Visibility="{Binding IsDeployStep, Converter={StaticResource InverseBoolToVis}}" />

                        <!-- Deploy + finished: Start over / Close -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsFinished, Converter={StaticResource BoolToVis}}">
                            <Button Content="Start over" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                                    Command="{Binding StartOverCommand}" />
                            <Button Content="Close" Style="{StaticResource PrimaryButton}" MinWidth="110"
                                    Command="{Binding ExitCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
